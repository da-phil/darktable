#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(std430, binding = 0)  readonly buffer  In0 { float data[]; } input_buf;
layout(std430, binding = 1)  readonly buffer  In1 { float data[]; } output1;
layout(std430, binding = 2)           buffer  Out { float data[]; } output0;
layout(std430, binding = 3)  readonly buffer  G0L0{ float data[]; } g0_l0;
layout(std430, binding = 4)  readonly buffer  G0L1{ float data[]; } g0_l1;
layout(std430, binding = 5)  readonly buffer  G1L0{ float data[]; } g1_l0;
layout(std430, binding = 6)  readonly buffer  G1L1{ float data[]; } g1_l1;
layout(std430, binding = 7)  readonly buffer  G2L0{ float data[]; } g2_l0;
layout(std430, binding = 8)  readonly buffer  G2L1{ float data[]; } g2_l1;
layout(std430, binding = 9)  readonly buffer  G3L0{ float data[]; } g3_l0;
layout(std430, binding = 10) readonly buffer  G3L1{ float data[]; } g3_l1;
layout(std430, binding = 11) readonly buffer  G4L0{ float data[]; } g4_l0;
layout(std430, binding = 12) readonly buffer  G4L1{ float data[]; } g4_l1;
layout(std430, binding = 13) readonly buffer  G5L0{ float data[]; } g5_l0;
layout(std430, binding = 14) readonly buffer  G5L1{ float data[]; } g5_l1;
layout(push_constant) uniform PC {
  int pw; int ph; int cw; int ch;
} pc;

const float W[5] = float[5](1.0/16.0, 4.0/16.0, 6.0/16.0, 4.0/16.0, 1.0/16.0);

float expand_g0(int i, int j, int sw) {
  int cx = i / 2;
  int cy = j / 2;
  float c = 0.0;
  int sel = (i & 1) + 2 * (j & 1);
  if(sel == 0) {
    for(int ii = -1; ii <= 1; ii++)
      for(int jj = -1; jj <= 1; jj++) {
        int xx = clamp(cx + ii, 0, pc.cw - 1);
        int yy = clamp(cy + jj, 0, pc.ch - 1);
        c += output1.data[yy * pc.cw + xx] * W[2 * jj + 2] * W[2 * ii + 2];
      }
  } else if(sel == 1) {
    for(int ii = 0; ii <= 1; ii++)
      for(int jj = -1; jj <= 1; jj++) {
        int xx = clamp(cx + ii, 0, pc.cw - 1);
        int yy = clamp(cy + jj, 0, pc.ch - 1);
        c += output1.data[yy * pc.cw + xx] * W[2 * jj + 2] * W[2 * ii + 1];
      }
  } else if(sel == 2) {
    for(int ii = -1; ii <= 1; ii++)
      for(int jj = 0; jj <= 1; jj++) {
        int xx = clamp(cx + ii, 0, pc.cw - 1);
        int yy = clamp(cy + jj, 0, pc.ch - 1);
        c += output1.data[yy * pc.cw + xx] * W[2 * jj + 1] * W[2 * ii + 2];
      }
  } else {
    for(int ii = 0; ii <= 1; ii++)
      for(int jj = 0; jj <= 1; jj++) {
        int xx = clamp(cx + ii, 0, pc.cw - 1);
        int yy = clamp(cy + jj, 0, pc.ch - 1);
        c += output1.data[yy * pc.cw + xx] * W[2 * jj + 1] * W[2 * ii + 1];
      }
  }
  return 4.0 * c;
}

#define EXPAND(buf, i, j) \
  expand_kernel_##buf(i, j)

// Repeat the expand_gaussian function bound to a specific coarse
// buffer. GLSL doesn't take buffer references as args, so we
// generate one function per gamma's coarse buffer via a macro.
#define EXPAND_FN(name, src) \
float name(int i, int j) { \
  int cx = i / 2; \
  int cy = j / 2; \
  float c = 0.0; \
  int sel = (i & 1) + 2 * (j & 1); \
  if(sel == 0) { \
    for(int ii = -1; ii <= 1; ii++) \
      for(int jj = -1; jj <= 1; jj++) { \
        int xx = clamp(cx + ii, 0, pc.cw - 1); \
        int yy = clamp(cy + jj, 0, pc.ch - 1); \
        c += src.data[yy * pc.cw + xx] * W[2 * jj + 2] * W[2 * ii + 2]; \
      } \
  } else if(sel == 1) { \
    for(int ii = 0; ii <= 1; ii++) \
      for(int jj = -1; jj <= 1; jj++) { \
        int xx = clamp(cx + ii, 0, pc.cw - 1); \
        int yy = clamp(cy + jj, 0, pc.ch - 1); \
        c += src.data[yy * pc.cw + xx] * W[2 * jj + 2] * W[2 * ii + 1]; \
      } \
  } else if(sel == 2) { \
    for(int ii = -1; ii <= 1; ii++) \
      for(int jj = 0; jj <= 1; jj++) { \
        int xx = clamp(cx + ii, 0, pc.cw - 1); \
        int yy = clamp(cy + jj, 0, pc.ch - 1); \
        c += src.data[yy * pc.cw + xx] * W[2 * jj + 1] * W[2 * ii + 2]; \
      } \
  } else { \
    for(int ii = 0; ii <= 1; ii++) \
      for(int jj = 0; jj <= 1; jj++) { \
        int xx = clamp(cx + ii, 0, pc.cw - 1); \
        int yy = clamp(cy + jj, 0, pc.ch - 1); \
        c += src.data[yy * pc.cw + xx] * W[2 * jj + 1] * W[2 * ii + 1]; \
      } \
  } \
  return 4.0 * c; \
}

EXPAND_FN(expand_g0_l1, g0_l1)
EXPAND_FN(expand_g1_l1, g1_l1)
EXPAND_FN(expand_g2_l1, g2_l1)
EXPAND_FN(expand_g3_l1, g3_l1)
EXPAND_FN(expand_g4_l1, g4_l1)
EXPAND_FN(expand_g5_l1, g5_l1)

void main() {
  int x = int(gl_GlobalInvocationID.x);
  int y = int(gl_GlobalInvocationID.y);
  if(x >= pc.pw || y >= pc.ph) return;

  int i = x, j = y;
  if((pc.pw & 1) != 0) { if(x > pc.pw - 2) i = pc.pw - 2; }
  else                 { if(x > pc.pw - 3) i = pc.pw - 3; }
  if((pc.ph & 1) != 0) { if(y > pc.ph - 2) j = pc.ph - 2; }
  else                 { if(y > pc.ph - 3) j = pc.ph - 3; }
  if(x <= 0) i = 1;
  if(y <= 0) j = 1;

  float pixel = expand_g0(i, j, pc.pw);

  const int num_gamma = 6;
  float v = input_buf.data[y * pc.pw + x];
  int hi = 1;
  for(; hi < num_gamma - 1 && (float(hi) + 0.5) / float(num_gamma) <= v; hi++) {}
  int lo = hi - 1;
  float a = clamp(v * float(num_gamma) - (float(lo) + 0.5), 0.0, 1.0);

  int ci = clamp(i, 0, pc.pw - 1);
  int cj = clamp(j, 0, pc.ph - 1);
  int fx = clamp(x, 0, pc.pw - 1);
  int fy = clamp(y, 0, pc.ph - 1);

  float l0 = 0.0, l1 = 0.0;
  if(lo == 0) {
    l0 = g0_l0.data[fy * pc.pw + fx] - expand_g0_l1(ci, cj);
    l1 = g1_l0.data[fy * pc.pw + fx] - expand_g1_l1(ci, cj);
  } else if(lo == 1) {
    l0 = g1_l0.data[fy * pc.pw + fx] - expand_g1_l1(ci, cj);
    l1 = g2_l0.data[fy * pc.pw + fx] - expand_g2_l1(ci, cj);
  } else if(lo == 2) {
    l0 = g2_l0.data[fy * pc.pw + fx] - expand_g2_l1(ci, cj);
    l1 = g3_l0.data[fy * pc.pw + fx] - expand_g3_l1(ci, cj);
  } else if(lo == 3) {
    l0 = g3_l0.data[fy * pc.pw + fx] - expand_g3_l1(ci, cj);
    l1 = g4_l0.data[fy * pc.pw + fx] - expand_g4_l1(ci, cj);
  } else {
    l0 = g4_l0.data[fy * pc.pw + fx] - expand_g4_l1(ci, cj);
    l1 = g5_l0.data[fy * pc.pw + fx] - expand_g5_l1(ci, cj);
  }
  pixel += l0 * (1.0 - a) + l1 * a;

  output0.data[y * pc.pw + x] = pixel;
}
