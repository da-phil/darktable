// GLSL fallback for whitebalance_1f_xtrans.cl.

#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(std430, binding = 0) readonly buffer In   { float data[]; } in_buf;
layout(std430, binding = 1)          buffer Out  { float data[]; } out_buf;
layout(std430, binding = 2) readonly buffer XTrn { uint  data[]; } xtrn_buf;

layout(push_constant) uniform PC {
    int width;
    int height;
    float c0;
    float c1;
    float c2;
    float c3;
} pc;

int FCxtrans(int row, int col) {
    return int(xtrn_buf.data[((row + 600) % 6) * 6 + ((col + 600) % 6)]);
}

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if (x >= pc.width || y >= pc.height) return;
    int idx = y * pc.width + x;
    float pixel = in_buf.data[idx];
    int fc = FCxtrans(y, x);
    float coeff = pc.c0;
    if      (fc == 1) coeff = pc.c1;
    else if (fc == 2) coeff = pc.c2;
    else if (fc == 3) coeff = pc.c3;
    out_buf.data[idx] = pixel * coeff;
}
