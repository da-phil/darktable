// GLSL fallback for lowlight.cl. See the .cl header for design notes.
// vk_Lab_to_XYZ / vk_XYZ_to_Lab inlined here because GLSL has no
// #include — keep in sync with dt_vulkan_common.h.

#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer In  { vec4  data[]; } in_buf;
layout(std430, binding = 1)          buffer Out { vec4  data[]; } out_buf;
layout(std430, binding = 2) readonly buffer Lut { float data[]; } lut_buf;

layout(push_constant) uniform PC {
    int   width;
    int   height;
    float XYZ_sw_x;
    float XYZ_sw_y;
    float XYZ_sw_z;
    float XYZ_sw_w;
} pc;

#define VK_LUT_SIZE 0x10000
#define NORM_MIN    1.52587890625e-05

float vk_lookup(float x) {
    int xi = clamp(int(x * float(VK_LUT_SIZE)), 0, VK_LUT_SIZE - 1);
    return lut_buf.data[xi];
}

vec4 lab_f(vec4 x) {
    vec4 epsilon = vec4(216.0 / 24389.0);
    vec4 kappa   = vec4(24389.0 / 27.0);
    bvec4 m = greaterThan(x, epsilon);
    vec4 a = vec4(pow(x.x, 1.0/3.0), pow(x.y, 1.0/3.0),
                  pow(x.z, 1.0/3.0), pow(x.w, 1.0/3.0));
    vec4 b = (kappa * x + vec4(16.0)) / vec4(116.0);
    return mix(b, a, m);
}

vec4 lab_f_inv(vec4 x) {
    vec4 epsilon = vec4(0.20689655172413796); // cbrt(216/24389)
    vec4 kappa   = vec4(24389.0 / 27.0);
    bvec4 m = greaterThan(x, epsilon);
    vec4 a = x * x * x;
    vec4 b = (vec4(116.0) * x - vec4(16.0)) / kappa;
    return mix(b, a, m);
}

vec4 Lab_to_XYZ(vec4 Lab) {
    vec4 d50 = vec4(0.9642, 1.0, 0.8249, 0.0);
    vec4 f;
    f.y = (Lab.x + 16.0) / 116.0;
    f.x = Lab.y / 500.0 + f.y;
    f.z = f.y - Lab.z / 200.0;
    f.w = 0.0;
    vec4 xyz = d50 * lab_f_inv(f);
    xyz.w = Lab.w;
    return xyz;
}

vec4 XYZ_to_Lab(vec4 xyz) {
    vec4 d50i = vec4(1.0/0.9642, 1.0, 1.0/0.8249, 1.0);
    vec4 f = lab_f(xyz * d50i);
    vec4 lab;
    lab.x = 116.0 * f.y - 16.0;
    lab.y = 500.0 * (f.x - f.y);
    lab.z = 200.0 * (f.y - f.z);
    lab.w = xyz.w;
    return lab;
}

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if(x >= pc.width || y >= pc.height) return;
    int idx = y * pc.width + x;

    vec4 pixel = in_buf.data[idx];
    vec4 XYZ   = Lab_to_XYZ(pixel);

    float c = 0.5;
    float threshold = 0.01;
    float denom = (XYZ.x > threshold) ? XYZ.x : threshold;
    float V = clamp(c * XYZ.y * (1.33 * (1.0 + (XYZ.y + XYZ.z) / denom) - 1.68),
                    0.0, 1.0);

    float w = vk_lookup(pixel.x / 100.0);
    vec4 sw = vec4(pc.XYZ_sw_x, pc.XYZ_sw_y, pc.XYZ_sw_z, pc.XYZ_sw_w);

    XYZ = w * XYZ + (1.0 - w) * V * sw;
    out_buf.data[idx] = XYZ_to_Lab(XYZ);
}
