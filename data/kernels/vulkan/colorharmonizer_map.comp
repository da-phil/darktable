// GLSL fallback for colorharmonizer_map.cl.

#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

#define COLORHARMONIZER_MAX_NODES 4
#define DT_UCS_L_STAR_RANGE       2.098883786377
#define DT_UCS_Y_UPPER_LIMIT      1e8
#define DT_PI                     3.14159265358979323846
#define DT_2PI                    6.28318530717958647692

layout(std430, binding = 0) readonly buffer In   { vec4  data[]; } in_buf;
layout(std430, binding = 1)          buffer Pout { vec4  data[]; } p_out;
layout(std430, binding = 2)          buffer Jch  { vec4  data[]; } jch_out;
layout(std430, binding = 3) readonly buffer Min  { float data[]; } matrix_in;
layout(std430, binding = 4) readonly buffer Nd   { float data[]; } nodes;
layout(std430, binding = 5) readonly buffer Ns   { float data[]; } node_saturation;

layout(push_constant) uniform PC {
    int   width;
    int   height;
    int   num_nodes;
    float zone_width;
    float L_white;
} pc;

vec4 mat3x3_apply(vec4 v) {
    float R = matrix_in.data[0] * v.x + matrix_in.data[1] * v.y + matrix_in.data[2] * v.z;
    float G = matrix_in.data[3] * v.x + matrix_in.data[4] * v.y + matrix_in.data[5] * v.z;
    float B = matrix_in.data[6] * v.x + matrix_in.data[7] * v.y + matrix_in.data[8] * v.z;
    return vec4(R, G, B, v.w);
}

vec4 d65_xyz_to_xyY(vec4 sXYZ) {
    vec4 XYZ = max(vec4(0.0), sXYZ);
    vec4 xyY;
    float sum = XYZ.x + XYZ.y + XYZ.z;
    if(sum > 0.0) { xyY.x = XYZ.x / sum; xyY.y = XYZ.y / sum; }
    else          { xyY.x = 0.31271; xyY.y = 0.32902; }
    xyY.z = XYZ.y;
    xyY.w = sXYZ.w;
    return xyY;
}

float Y_to_L_star(float Y) {
    float Y_hat = pow(Y, 0.631651345306265);
    return DT_UCS_L_STAR_RANGE * Y_hat / (Y_hat + 1.12426773749357);
}

vec2 xyY_to_UCS_UV(vec4 xyY) {
    vec4 x_factors = vec4(-0.783941002840055,  0.745273540913283, 0.318707282433486, 0.0);
    vec4 y_factors = vec4( 0.277512987809202, -0.205375866083878, 2.16743692732158,  0.0);
    vec4 offsets   = vec4( 0.153836578598858, -0.165478376301988, 0.291320554395942, 0.0);

    vec4 UVD = x_factors * xyY.x + y_factors * xyY.y + offsets;
    float div = (UVD.z >= 0.0) ? max(1.175494351e-38, UVD.z) : min(-1.175494351e-38, UVD.z);
    UVD.x /= div;
    UVD.y /= div;

    vec2 factors     = vec2(1.39656225667, 1.4513954287);
    vec2 half_values = vec2(1.49217352929, 1.52488637914);
    vec2 UV_star = vec2(
        factors.x * UVD.x / (abs(UVD.x) + half_values.x),
        factors.y * UVD.y / (abs(UVD.y) + half_values.y));
    return vec2(
        -1.124983854323892 * UV_star.x - 0.980483721769325 * UV_star.y,
         1.86323315098672  * UV_star.x + 1.971853092390862 * UV_star.y);
}

vec4 xyY_to_UCS_JCH(vec4 xyY, float L_white) {
    vec2 UV_star_prime = xyY_to_UCS_UV(xyY);
    float L_star = Y_to_L_star(clamp(xyY.z, 0.0, DT_UCS_Y_UPPER_LIMIT));
    float M2 = UV_star_prime.x * UV_star_prime.x + UV_star_prime.y * UV_star_prime.y;
    return vec4(
        L_star / L_white,
        15.932993652962535 * pow(L_star, 0.6523997524738018)
                           * pow(M2, 0.6007557017508491) / L_white,
        atan(UV_star_prime.y, UV_star_prime.x),
        0.0);
}

float weighted_hue_shift(float px_hue, int num_nodes, float zone_width,
                         out int winning_idx, out float max_weight) {
    if(num_nodes <= 0) { winning_idx = 0; max_weight = 0.0; return 0.0; }
    float sigma = zone_width * 0.5 / float(num_nodes);
    float inv_2sigma2 = 1.0 / (2.0 * sigma * sigma);

    float max_w = 0.0;
    int   win   = 0;
    float diff_w = 0.0;

    for(int i = 0; i < COLORHARMONIZER_MAX_NODES; i++) {
        if(i >= num_nodes) break;
        float d = abs(px_hue - nodes.data[i]);
        if(d > 0.5) d = 1.0 - d;
        float w = exp(-d * d * inv_2sigma2);
        float diff = nodes.data[i] - px_hue;
        if(diff > 0.5)       diff -= 1.0;
        else if(diff < -0.5) diff += 1.0;
        if(w > max_w) { max_w = w; win = i; diff_w = diff; }
    }
    winning_idx = win;
    max_weight  = max_w;
    return diff_w * max_w;
}

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if(x >= pc.width || y >= pc.height) return;
    int idx = y * pc.width + x;

    vec4 pix_in  = in_buf.data[idx];
    vec4 XYZ_D65 = mat3x3_apply(max(vec4(0.0), pix_in));
    vec4 xyY     = d65_xyz_to_xyY(XYZ_D65);
    vec4 JCH     = xyY_to_UCS_JCH(xyY, pc.L_white);

    float hue = (JCH.z + DT_PI) / DT_2PI;
    jch_out.data[idx] = vec4(JCH.x, JCH.y, hue, pix_in.w);

    int   winning_idx;
    float max_weight;
    float hue_shift = weighted_hue_shift(hue, pc.num_nodes, pc.zone_width,
                                         winning_idx, max_weight);
    float sd = (node_saturation.data[winning_idx] - 1.0) * max_weight;
    p_out.data[idx] = vec4(hue_shift, sd, 0.0, 0.0);
}
