// GLSL fallback for colorharmonizer_apply.cl.

#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

#define DT_UCS_L_STAR_RANGE        2.098883786377
#define DT_UCS_L_STAR_UPPER_LIMIT  2.09885
#define DT_PI                      3.14159265358979323846
#define DT_2PI                     6.28318530717958647692

layout(std430, binding = 0)          buffer Out  { vec4  data[]; } out_buf;
layout(std430, binding = 1) readonly buffer Mout { float data[]; } matrix_out;
layout(std430, binding = 2) readonly buffer Jch  { vec4  data[]; } jch_in;
layout(std430, binding = 3) readonly buffer Cor  { vec4  data[]; } corrections;

layout(push_constant) uniform PC {
    int   width;
    int   height;
    float effect_strength;
    float protect_neutral;
    float L_white;
} pc;

vec4 mat3x3_apply(vec4 v) {
    float R = matrix_out.data[0] * v.x + matrix_out.data[1] * v.y + matrix_out.data[2] * v.z;
    float G = matrix_out.data[3] * v.x + matrix_out.data[4] * v.y + matrix_out.data[5] * v.z;
    float B = matrix_out.data[6] * v.x + matrix_out.data[7] * v.y + matrix_out.data[8] * v.z;
    return vec4(R, G, B, v.w);
}

float L_star_to_Y(float L_star) {
    return pow((1.12426773749357 * L_star / (DT_UCS_L_STAR_RANGE - L_star)),
               1.5831518565279648);
}

vec4 UCS_JCH_to_xyY(vec4 JCH, float L_white) {
    float L_star = clamp(JCH.x * L_white, 0.0, DT_UCS_L_STAR_UPPER_LIMIT);
    float M = (L_star != 0.0)
        ? pow(JCH.y * L_white / (15.932993652962535 * pow(L_star, 0.6523997524738018)),
              0.8322850678616855)
        : 0.0;
    float U_star_prime = M * cos(JCH.z);
    float V_star_prime = M * sin(JCH.z);

    vec2 UV_star = vec2(
        -5.037522385190711 * U_star_prime - 2.504856328185843 * V_star_prime,
         4.760029407436461 * U_star_prime + 2.874012963239247 * V_star_prime);

    vec2 factors     = vec2(1.39656225667, 1.4513954287);
    vec2 half_values = vec2(1.49217352929, 1.52488637914);
    vec2 UV = vec2(
        -half_values.x * UV_star.x / (abs(UV_star.x) - factors.x),
        -half_values.y * UV_star.y / (abs(UV_star.y) - factors.y));

    vec4 U_factors = vec4( 0.167171472114775,   -0.150959086409163,    0.940254742367256,  0.0);
    vec4 V_factors = vec4( 0.141299802443708,   -0.155185060382272,    1.000000000000000,  0.0);
    vec4 offsets   = vec4(-0.00801531300850582, -0.00843312433578007, -0.0256325967652889, 0.0);

    vec4 xyD = U_factors * UV.x + V_factors * UV.y + offsets;
    float div = (xyD.z >= 0.0) ? max(1.175494351e-38, xyD.z) : min(-1.175494351e-38, xyD.z);
    return vec4(xyD.x / div, xyD.y / div, L_star_to_Y(L_star), 0.0);
}

vec4 xyY_to_XYZ(vec4 xyY) {
    vec4 XYZ = vec4(0.0, 0.0, 0.0, xyY.w);
    if(xyY.y != 0.0) {
        XYZ.x = xyY.z * xyY.x / xyY.y;
        XYZ.y = xyY.z;
        XYZ.z = xyY.z * (1.0 - xyY.x - xyY.y) / xyY.y;
    }
    return XYZ;
}

float wrap_hue(float h) {
    h = mod(h, 1.0);
    if(h < 0.0) h += 1.0;
    return h;
}

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if(x >= pc.width || y >= pc.height) return;
    int k = y * pc.width + x;

    vec4 cached = jch_in.data[k];
    float J      = cached.x;
    float chroma = cached.y;
    float hue    = cached.z;

    vec4 corr_pad = corrections.data[k];
    vec2 corr = corr_pad.xy;

    float t      = pc.protect_neutral;
    float cutoff = t * t * t * 0.03;
    float chroma_weight = chroma / (chroma + cutoff + 1.0e-5);

    vec4 JCH;
    JCH.x = J;
    JCH.y = max(chroma * (1.0 + corr.y * chroma_weight), 0.0);
    JCH.z = wrap_hue(hue + corr.x * pc.effect_strength * chroma_weight) * DT_2PI - DT_PI;

    vec4 xyY = UCS_JCH_to_xyY(JCH, pc.L_white);
    vec4 XYZ_D65 = xyY_to_XYZ(xyY);

    vec4 pix_out = mat3x3_apply(XYZ_D65);
    pix_out.w = cached.w;
    out_buf.data[k] = pix_out;
}
