// GLSL fallback for guided_filter_box_mean_x.cl.

#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(std430, binding = 0) readonly buffer In  { float data[]; } in_buf;
layout(std430, binding = 1)          buffer Out { float data[]; } out_buf;
layout(push_constant) uniform PC {
    int width;
    int height;
    int w;
} pc;

#define KSUM(m, c, add) { float _t1 = (add) - (c); float _t2 = (m) + _t1; (c) = (_t2 - (m)) - _t1; (m) = _t2; }

void main() {
    int y = int(gl_GlobalInvocationID.x);
    if (y >= pc.height) return;
    int row = y * pc.width;
    int w = pc.w;

    float m = 0.0, n_box = 0.0, c = 0.0;
    if (pc.width > 2 * w) {
        for (int i = 0, i_end = w + 1; i < i_end; i++) {
            KSUM(m, c, in_buf.data[row + i]); n_box += 1.0;
        }
        for (int i = 0, i_end = w; i < i_end; i++) {
            out_buf.data[row + i] = m / n_box;
            KSUM(m, c, in_buf.data[row + i + w + 1]); n_box += 1.0;
        }
        for (int i = w, i_end = pc.width - w - 1; i < i_end; i++) {
            out_buf.data[row + i] = m / n_box;
            KSUM(m, c, in_buf.data[row + i + w + 1]);
            KSUM(m, c, -in_buf.data[row + i - w]);
        }
        for (int i = pc.width - w - 1, i_end = pc.width; i < i_end; i++) {
            out_buf.data[row + i] = m / n_box;
            KSUM(m, c, -in_buf.data[row + i - w]); n_box -= 1.0;
        }
    } else {
        for (int i = 0, i_end = min(w + 1, pc.width); i < i_end; i++) {
            KSUM(m, c, in_buf.data[row + i]); n_box += 1.0;
        }
        for (int i = 0; i < pc.width; i++) {
            out_buf.data[row + i] = m / n_box;
            if (i - w >= 0)        { KSUM(m, c, -in_buf.data[row + i - w]);     n_box -= 1.0; }
            if (i + w + 1 < pc.width) { KSUM(m, c, in_buf.data[row + i + w + 1]); n_box += 1.0; }
        }
    }
}
