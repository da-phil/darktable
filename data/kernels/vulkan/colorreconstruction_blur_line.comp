// GLSL fallback for colorreconstruction_blur_line.cl.

#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(std430, binding = 0) readonly buffer In  { vec4 data[]; } ibuf;
layout(std430, binding = 1)          buffer Out { vec4 data[]; } obuf;
layout(push_constant) uniform PC {
    int offset1;
    int offset2;
    int offset3;
    int size1;
    int size2;
    int size3;
} pc;

void main() {
    int k = int(gl_GlobalInvocationID.x);
    int j = int(gl_GlobalInvocationID.y);
    if (k >= pc.size1 || j >= pc.size2) return;

    float w0 = 6.0 / 16.0;
    float w1 = 4.0 / 16.0;
    float w2 = 1.0 / 16.0;
    int index = k * pc.offset1 + j * pc.offset2;

    vec4 tmp1 = ibuf.data[index];
    vec4 outv = ibuf.data[index] * w0
              + ibuf.data[index + pc.offset3] * w1
              + ibuf.data[index + 2 * pc.offset3] * w2;
    obuf.data[index] = outv;
    index += pc.offset3;

    vec4 tmp2 = ibuf.data[index];
    outv = ibuf.data[index] * w0
         + (ibuf.data[index + pc.offset3] + tmp1) * w1
         + ibuf.data[index + 2 * pc.offset3] * w2;
    obuf.data[index] = outv;
    index += pc.offset3;

    for (int i = 2; i < pc.size3 - 2; i++) {
        vec4 tmp3 = ibuf.data[index];
        outv = ibuf.data[index] * w0
             + (ibuf.data[index + pc.offset3]     + tmp2) * w1
             + (ibuf.data[index + 2 * pc.offset3] + tmp1) * w2;
        obuf.data[index] = outv;
        index += pc.offset3;
        tmp1 = tmp2;
        tmp2 = tmp3;
    }

    vec4 tmp3 = ibuf.data[index];
    outv = ibuf.data[index] * w0
         + (ibuf.data[index + pc.offset3] + tmp2) * w1
         + tmp1 * w2;
    obuf.data[index] = outv;
    index += pc.offset3;

    outv = ibuf.data[index] * w0 + tmp3 * w1 + tmp2 * w2;
    obuf.data[index] = outv;
}
