// GLSL fallback for bloom_mix.cl.

#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(std430, binding = 0) readonly buffer InA { vec4  data[]; } in_a;
layout(std430, binding = 1) readonly buffer InB { float data[]; } in_b;
layout(std430, binding = 2)          buffer Out { vec4  data[]; } out_buf;
layout(push_constant) uniform PC {
    int width;
    int height;
} pc;

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if (x >= pc.width || y >= pc.height) return;
    int idx = y * pc.width + x;

    vec4 pixel = in_a.data[idx];
    float processed = in_b.data[idx];
    pixel.x = 100.0 - ((100.0 - pixel.x) * (100.0 - processed)) / 100.0;
    out_buf.data[idx] = pixel;
}
