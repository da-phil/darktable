// GLSL twin of diffuse.cl. See the .cl header for scope — this is the
// single-pass unsharp-mask approximation; the full wavelet diffuse
// pipeline isn't ported here.

#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly  buffer In  { vec4 data[]; } in_buf;
layout(std430, binding = 1)           buffer Out { vec4 data[]; } out_buf;

layout(push_constant) uniform Params {
    int   width;
    int   height;
    float amount;
    float threshold;
} pc;

vec4 read_clamped(int x, int y) {
    int cx = clamp(x, 0, pc.width  - 1);
    int cy = clamp(y, 0, pc.height - 1);
    return in_buf.data[cy * pc.width + cx];
}

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if (x >= pc.width || y >= pc.height) return;
    int idx = y * pc.width + x;

    vec4 sum = vec4(0.0);
    for (int dy = -1; dy <= 1; ++dy)
        for (int dx = -1; dx <= 1; ++dx)
            sum += read_clamped(x + dx, y + dy);
    vec4 blurred = sum * (1.0/9.0);

    vec4 pixel = in_buf.data[idx];
    vec4 diff  = pixel - blurred;

    float mag = abs(diff.x) + abs(diff.y) + abs(diff.z);
    float gate = (mag > pc.threshold) ? 1.0 : 0.0;

    vec4 result;
    result.rgb = pixel.rgb + gate * pc.amount * diff.rgb;
    result.a   = pixel.a;
    out_buf.data[idx] = result;
}
