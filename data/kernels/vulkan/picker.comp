// GLSL fallback for picker.cl :: picker_rgb.
// See the .cl header for design notes.

#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer In    { vec4  data[]; } in_buf;
layout(std430, binding = 1)          buffer Stats { uint  data[]; } stats;

layout(push_constant) uniform PC {
    int width;
    int box_x0;
    int box_y0;
    int box_x1;
    int box_y1;
    int mode;      // 0 raw, 1 Lab->LCH, 2 RGB->HSL
} pc;

const float DT_2PI = 6.2831853071795864769;

// Lab -> LCH, matching dt_vulkan_common.h::vk_Lab_2_LCH / dt_Lab_2_LCH.
vec4 Lab_2_LCH(vec4 Lab) {
    float H = atan(Lab.z, Lab.y);
    H = (H > 0.0) ? H / DT_2PI : 1.0 - abs(H) / DT_2PI;
    float C = length(Lab.yz);
    return vec4(Lab.x, C, H, Lab.w);
}

// RGB -> HSL, matching dt_vulkan_common.h::vk_RGB_to_HSL / dt_RGB_2_HSL.
vec4 RGB_2_HSL(vec4 RGB) {
    float R = RGB.x, G = RGB.y, B = RGB.z;
    float vmin = min(R, min(G, B));
    float vmax = max(R, max(G, B));
    float dmax = vmax - vmin;
    float L = (vmax + vmin) * 0.5;
    float H = 0.0, S = 0.0;
    if(abs(vmax) > 1e-6 && abs(dmax) > 1e-6) {
        S = (L < 0.5) ? dmax / (vmax + vmin) : dmax / (2.0 - vmax - vmin);
        float dR = (((vmax - R) / 6.0) + (dmax / 2.0)) / dmax;
        float dG = (((vmax - G) / 6.0) + (dmax / 2.0)) / dmax;
        float dB = (((vmax - B) / 6.0) + (dmax / 2.0)) / dmax;
        if(R == vmax)      H = dB - dG;
        else if(G == vmax) H = (1.0 / 3.0) + dR - dB;
        else if(B == vmax) H = (2.0 / 3.0) + dG - dR;
        if(H < 0.0) H += 1.0;
        if(H > 1.0) H -= 1.0;
    }
    return vec4(H, S, L, RGB.w);
}

// Float atomics via reinterpret-CAS (no native float atomics in core
// GLSL), matching dt_vulkan_common.h::vk_atomic_{add,min,max}_f.
void atomic_add_f(uint idx, float v) {
    uint old = stats.data[idx];
    uint expected;
    do {
        expected = old;
        float nv = uintBitsToFloat(expected) + v;
        old = atomicCompSwap(stats.data[idx], expected, floatBitsToUint(nv));
    } while(old != expected);
}

void atomic_min_f(uint idx, float v) {
    uint old = stats.data[idx];
    uint expected;
    do {
        if(uintBitsToFloat(old) <= v) return;
        expected = old;
        old = atomicCompSwap(stats.data[idx], expected, floatBitsToUint(v));
    } while(old != expected);
}

void atomic_max_f(uint idx, float v) {
    uint old = stats.data[idx];
    uint expected;
    do {
        if(uintBitsToFloat(old) >= v) return;
        expected = old;
        old = atomicCompSwap(stats.data[idx], expected, floatBitsToUint(v));
    } while(old != expected);
}

void main() {
    int gx = int(gl_GlobalInvocationID.x);
    int gy = int(gl_GlobalInvocationID.y);
    int bw = pc.box_x1 - pc.box_x0;
    int bh = pc.box_y1 - pc.box_y0;
    if(gx >= bw || gy >= bh) return;

    int x = pc.box_x0 + gx;
    int y = pc.box_y0 + gy;
    vec4 px = in_buf.data[y * pc.width + x];

    if(pc.mode == 1)      px = Lab_2_LCH(px);
    else if(pc.mode == 2) px = RGB_2_HSL(px);
    if(pc.mode != 0)
        px.w = (px.z < 0.5) ? px.z + 0.5 : px.z - 0.5;

    atomic_add_f(0u, px.x);
    atomic_add_f(1u, px.y);
    atomic_add_f(2u, px.z);
    atomic_add_f(3u, px.w);

    atomic_min_f(4u, px.x);
    atomic_min_f(5u, px.y);
    atomic_min_f(6u, px.z);
    atomic_min_f(7u, px.w);

    atomic_max_f(8u,  px.x);
    atomic_max_f(9u,  px.y);
    atomic_max_f(10u, px.z);
    atomic_max_f(11u, px.w);
}
