// GLSL fallback for colorspaces_transform_rgb_matrix_to_lab.
// See the .cl header for design notes.

#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer In  { vec4 data[]; } in_buf;
layout(std430, binding = 1)          buffer Out { vec4 data[]; } out_buf;

layout(std430, binding = 2) readonly buffer Prof {
    float matrix_in[9];
    float matrix_out[9];
    int   lutsize;
    float unbounded_coeffs_in[9];
    float unbounded_coeffs_out[9];
    int   nonlinearlut;
    float grey;
} profile_info;

layout(std430, binding = 3) readonly buffer Lut { float data[]; } lut;

layout(push_constant) uniform PC {
    int width;
    int height;
} pc;

float lerp_lookup(float x, float c0, float c1, float c2, int n_lut)
{
    if(c0 >= 0.0) {
        if(x < 1.0) {
            int sz = profile_info.lutsize;
            float ft = clamp(x * float(sz - 1), 0.0, float(sz - 1));
            int   t  = (ft < float(sz - 2)) ? int(ft) : sz - 2;
            float f  = ft - float(t);
            int   base = n_lut * sz;
            return lut.data[base + t] * (1.0 - f) + lut.data[base + t + 1] * f;
        }
        return c1 * pow(x * c0, c2);
    }
    return x;
}

vec4 apply_trc_in(vec4 rgb) {
    float R = lerp_lookup(rgb.x,
        profile_info.unbounded_coeffs_in[0],
        profile_info.unbounded_coeffs_in[1],
        profile_info.unbounded_coeffs_in[2], 0);
    float G = lerp_lookup(rgb.y,
        profile_info.unbounded_coeffs_in[3],
        profile_info.unbounded_coeffs_in[4],
        profile_info.unbounded_coeffs_in[5], 1);
    float B = lerp_lookup(rgb.z,
        profile_info.unbounded_coeffs_in[6],
        profile_info.unbounded_coeffs_in[7],
        profile_info.unbounded_coeffs_in[8], 2);
    return vec4(R, G, B, rgb.w);
}

// XYZ (D50) -> Lab, matching dt_vulkan_common.h::vk_XYZ_to_Lab.
vec4 lab_f(vec4 x) {
    const vec4 epsilon = vec4(216.0 / 24389.0);
    const vec4 kappa   = vec4(24389.0 / 27.0);
    vec4 gt = pow(max(x, vec4(0.0)), vec4(1.0 / 3.0));
    vec4 le = (kappa * x + vec4(16.0)) / vec4(116.0);
    return mix(le, gt, greaterThan(x, epsilon));
}

vec4 XYZ_to_Lab(vec4 xyz) {
    const vec4 d50i = vec4(1.0 / 0.9642, 1.0, 1.0 / 0.8249, 1.0);
    vec4 f = lab_f(xyz * d50i);
    vec4 lab;
    lab.x = 116.0 * f.y - 16.0;
    lab.y = 500.0 * (f.x - f.y);
    lab.z = 200.0 * (f.y - f.z);
    lab.w = xyz.w;
    return lab;
}

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if(x >= pc.width || y >= pc.height) return;
    int idx = y * pc.width + x;

    vec4 pixel = in_buf.data[idx];
    if(profile_info.nonlinearlut != 0)
        pixel = apply_trc_in(pixel);

    vec4 xyz;
    xyz.x = profile_info.matrix_in[0] * pixel.x + profile_info.matrix_in[1] * pixel.y
          + profile_info.matrix_in[2] * pixel.z;
    xyz.y = profile_info.matrix_in[3] * pixel.x + profile_info.matrix_in[4] * pixel.y
          + profile_info.matrix_in[5] * pixel.z;
    xyz.z = profile_info.matrix_in[6] * pixel.x + profile_info.matrix_in[7] * pixel.y
          + profile_info.matrix_in[8] * pixel.z;
    xyz.w = pixel.w;

    out_buf.data[idx] = XYZ_to_Lab(xyz);
}
