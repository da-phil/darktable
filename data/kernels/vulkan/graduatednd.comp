// GLSL fallback for graduatednd.cl.
//
// Single kernel branches on the sign of density to cover both the
// positive (divide) and negative (multiply) paths the OpenCL build
// splits into graduatedndp / graduatedndm. The branch is uniform
// across the dispatch.

#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(std430, binding = 0) readonly buffer In  { vec4 data[]; } in_buf;
layout(std430, binding = 1)          buffer Out { vec4 data[]; } out_buf;
// Push-constant scalars are laid out in source order, no vec4-align
// padding — this matches the clspv path (which packs every kernel
// scalar arg back-to-back) and keeps the C-side struct (10 ints/floats
// = 40 bytes) byte-identical between the two compilation paths.
layout(push_constant) uniform PC {
    int   width;
    int   height;
    float density;
    float length_base;
    float length_inc_x;
    float length_inc_y;
    float color_r;
    float color_g;
    float color_b;
    float color_a;
} pc;

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if (x >= pc.width || y >= pc.height) return;
    int i = y * pc.width + x;

    vec4 pixel = in_buf.data[i];
    vec4 color = vec4(pc.color_r, pc.color_g, pc.color_b, pc.color_a);
    float len = pc.length_base + float(y) * pc.length_inc_y + float(x) * pc.length_inc_x;

    vec4 result;
    if (pc.density > 0.0) {
        float dens = exp2(pc.density * clamp(0.5 + len, 0.0, 1.0));
        result = pixel / (color + (vec4(1.0) - color) * dens);
    } else {
        float dens = exp2(-pc.density * clamp(0.5 - len, 0.0, 1.0));
        result = pixel * (color + (vec4(1.0) - color) * dens);
    }
    result.w = pixel.w;
    out_buf.data[i] = result;
}
