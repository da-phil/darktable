#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(std430, binding = 0) readonly buffer Src  { vec4 data[]; }  src_buf;
layout(std430, binding = 1)          buffer Dst  { vec4 data[]; }  dst_buf;
layout(std430, binding = 2) readonly buffer Mask { float data[]; } mask_buf;
layout(push_constant) uniform PC {
  int roi_dest_x; int roi_dest_y; int roi_dest_width;
  int roi_ms_x; int roi_ms_y; int roi_ms_width; int roi_ms_height;
  float opacity;
} pc;
void main() {
  int x = int(gl_GlobalInvocationID.x);
  int y = int(gl_GlobalInvocationID.y);
  if(x >= pc.roi_ms_width || y >= pc.roi_ms_height) return;
  int di = (y + pc.roi_ms_y - pc.roi_dest_y) * pc.roi_dest_width
         + (x + pc.roi_ms_x - pc.roi_dest_x);
  int si = y * pc.roi_ms_width + x;
  float f = clamp(mask_buf.data[si] * pc.opacity, 0.0, 1.0);
  float w = dst_buf.data[di].w;
  vec4 v = dst_buf.data[di] * (1.0 - f) + src_buf.data[si] * f;
  v.w = w;
  dst_buf.data[di] = v;
}
