// GLSL fallback for soften_mix.cl.

#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(std430, binding = 0) readonly buffer InA { vec4 data[]; } in_a;
layout(std430, binding = 1) readonly buffer InB { vec4 data[]; } in_b;
layout(std430, binding = 2)          buffer Out { vec4 data[]; } out_buf;
layout(push_constant) uniform PC {
    int   width;
    int   height;
    float amount;
} pc;

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if (x >= pc.width || y >= pc.height) return;
    int idx = y * pc.width + x;

    vec4 orig = in_a.data[idx];
    vec4 proc = in_b.data[idx];
    vec4 pix  = orig * (1.0 - pc.amount) + clamp(proc, vec4(0.0), vec4(1.0)) * pc.amount;
    pix.w = orig.w;
    out_buf.data[idx] = pix;
}
