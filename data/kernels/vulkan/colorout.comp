// GLSL fallback for colorout.cl. See the .cl header for design.

#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer In    { vec4  data[]; } in_buf;
layout(std430, binding = 1)          buffer Out   { vec4  data[]; } out_buf;
layout(std430, binding = 2) readonly buffer LutR  { float data[]; } lut_r;
layout(std430, binding = 3) readonly buffer LutG  { float data[]; } lut_g;
layout(std430, binding = 4) readonly buffer LutB  { float data[]; } lut_b;

layout(push_constant) uniform PC {
    int   width;
    int   height;
    float m00; float m01; float m02;
    float m10; float m11; float m12;
    float m20; float m21; float m22;
    float ar0; float ar1; float ar2;
    float ag0; float ag1; float ag2;
    float ab0; float ab1; float ab2;
} pc;

#define VK_LUT_SIZE 0x10000

// Lab → XYZ (D50 white point). Mirrors dt_vulkan_common.h::vk_Lab_to_XYZ.
vec4 lab_f_inv(vec4 x) {
    vec4 eps = vec4(0.20689655172413796);
    vec4 k   = vec4(24389.0 / 27.0);
    bvec4 m = greaterThan(x, eps);
    vec4 a = x * x * x;
    vec4 b = (vec4(116.0) * x - vec4(16.0)) / k;
    return mix(b, a, m);
}
vec4 Lab_to_XYZ(vec4 Lab) {
    vec4 d50 = vec4(0.9642, 1.0, 0.8249, 0.0);
    vec4 f;
    f.y = (Lab.x + 16.0) / 116.0;
    f.x = Lab.y / 500.0 + f.y;
    f.z = f.y - Lab.z / 200.0;
    f.w = 0.0;
    vec4 xyz = d50 * lab_f_inv(f);
    xyz.w = Lab.w;
    return xyz;
}

// Linearly-interpolated, unbounded LUT lookup with the matching tail
// extrapolation as the clspv path; the LUT helpers in
// dt_vulkan_common.h aren't usable here, so spell it out per channel.
float lookup_r(float x, float c0, float c1, float c2) {
    if(c0 < 0.0) return x;
    if(x < 1.0) {
        float ft = clamp(x * float(VK_LUT_SIZE - 1), 0.0, float(VK_LUT_SIZE - 1));
        int   t  = int(min(ft, float(VK_LUT_SIZE - 2)));
        float f  = ft - float(t);
        float l1 = lut_r.data[t];
        float l2 = lut_r.data[t + 1];
        return l1 * (1.0 - f) + l2 * f;
    }
    return c1 * pow(x * c0, c2);
}
float lookup_g(float x, float c0, float c1, float c2) {
    if(c0 < 0.0) return x;
    if(x < 1.0) {
        float ft = clamp(x * float(VK_LUT_SIZE - 1), 0.0, float(VK_LUT_SIZE - 1));
        int   t  = int(min(ft, float(VK_LUT_SIZE - 2)));
        float f  = ft - float(t);
        float l1 = lut_g.data[t];
        float l2 = lut_g.data[t + 1];
        return l1 * (1.0 - f) + l2 * f;
    }
    return c1 * pow(x * c0, c2);
}
float lookup_b(float x, float c0, float c1, float c2) {
    if(c0 < 0.0) return x;
    if(x < 1.0) {
        float ft = clamp(x * float(VK_LUT_SIZE - 1), 0.0, float(VK_LUT_SIZE - 1));
        int   t  = int(min(ft, float(VK_LUT_SIZE - 2)));
        float f  = ft - float(t);
        float l1 = lut_b.data[t];
        float l2 = lut_b.data[t + 1];
        return l1 * (1.0 - f) + l2 * f;
    }
    return c1 * pow(x * c0, c2);
}

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if(x >= pc.width || y >= pc.height) return;
    int idx = y * pc.width + x;

    vec4 pixel = in_buf.data[idx];
    vec4 xyz = Lab_to_XYZ(pixel);

    float r = pc.m00 * xyz.x + pc.m01 * xyz.y + pc.m02 * xyz.z;
    float g = pc.m10 * xyz.x + pc.m11 * xyz.y + pc.m12 * xyz.z;
    float b = pc.m20 * xyz.x + pc.m21 * xyz.y + pc.m22 * xyz.z;

    vec4 outp;
    outp.x = lookup_r(r, pc.ar0, pc.ar1, pc.ar2);
    outp.y = lookup_g(g, pc.ag0, pc.ag1, pc.ag2);
    outp.z = lookup_b(b, pc.ab0, pc.ab1, pc.ab2);
    outp.w = pixel.w;
    out_buf.data[idx] = outp;
}
