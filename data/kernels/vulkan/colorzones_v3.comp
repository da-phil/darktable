// GLSL fallback for colorzones_v3.cl.

#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer In   { vec4  data[]; } in_buf;
layout(std430, binding = 1)          buffer Out  { vec4  data[]; } out_buf;
layout(std430, binding = 2) readonly buffer TL   { float data[]; } table_L;
layout(std430, binding = 3) readonly buffer TA   { float data[]; } table_a;
layout(std430, binding = 4) readonly buffer TB   { float data[]; } table_b;

layout(push_constant) uniform PC {
    int width;
    int height;
    int channel;
} pc;

#define VK_LUT_SIZE     0x10000
#define VK_COLORZONES_L 0
#define VK_COLORZONES_C 1
#define VK_COLORZONES_h 2
#define DT_2PI          6.28318530717958647692

float lookup_L(float x) { return table_L.data[clamp(int(x*float(VK_LUT_SIZE)),0,VK_LUT_SIZE-1)]; }
float lookup_a(float x) { return table_a.data[clamp(int(x*float(VK_LUT_SIZE)),0,VK_LUT_SIZE-1)]; }
float lookup_b(float x) { return table_b.data[clamp(int(x*float(VK_LUT_SIZE)),0,VK_LUT_SIZE-1)]; }

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if(x >= pc.width || y >= pc.height) return;
    int idx = y * pc.width + x;

    vec4 pixel = in_buf.data[idx];
    float a = pixel.y;
    float b = pixel.z;
    float h = mod(atan(b, a) + DT_2PI, DT_2PI) / DT_2PI;
    float C = sqrt(a*a + b*b);

    float select = 0.0;
    float blend = 0.0;
    if(pc.channel == VK_COLORZONES_L) {
        select = min(1.0, pixel.x / 100.0);
    } else if(pc.channel == VK_COLORZONES_C) {
        select = min(1.0, C / 128.0);
    } else {
        select = h;
        float t = 1.0 - C / 128.0;
        blend = t * t;
    }

    float Lm = (blend * 0.5 + (1.0 - blend) * lookup_L(select)) - 0.5;
    float hm = (blend * 0.5 + (1.0 - blend) * lookup_b(select)) - 0.5;
    blend *= blend;
    float Cm = 2.0 * lookup_a(select);
    float L = pixel.x * pow(2.0, 4.0 * Lm);

    pixel.x = L;
    pixel.y = cos(DT_2PI * (h + hm)) * Cm * C;
    pixel.z = sin(DT_2PI * (h + hm)) * Cm * C;
    out_buf.data[idx] = pixel;
}
