#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(std430, binding = 0) readonly  buffer In   { float data[]; } in_buf;
layout(std430, binding = 1)           buffer Out  { float data[]; } coarse_buf;
layout(push_constant) uniform PC {
  int wd; int ht; int fine_w; int fine_h;
} pc;

void main() {
  int x = int(gl_GlobalInvocationID.x);
  int y = int(gl_GlobalInvocationID.y);
  if(x >= pc.wd || y >= pc.ht) return;

  int cx = clamp(x, 1, pc.wd - 2);
  int cy = clamp(y, 1, pc.ht - 2);
  float w[5] = float[5](1.0/16.0, 4.0/16.0, 6.0/16.0, 4.0/16.0, 1.0/16.0);
  float pixel = 0.0;
  for(int jj = -2; jj <= 2; jj++)
    for(int ii = -2; ii <= 2; ii++) {
      int fx = clamp(2 * cx + ii, 0, pc.fine_w - 1);
      int fy = clamp(2 * cy + jj, 0, pc.fine_h - 1);
      pixel += in_buf.data[fy * pc.fine_w + fx] * w[ii + 2] * w[jj + 2];
    }
  coarse_buf.data[y * pc.wd + x] = pixel;
}
