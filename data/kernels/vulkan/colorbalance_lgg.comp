// GLSL fallback for colorbalance_lgg.cl.
#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer In  { vec4 data[]; } in_buf;
layout(std430, binding = 1)          buffer Out { vec4 data[]; } out_buf;

layout(push_constant) uniform PC {
    int   width;
    int   height;
    float lift_r;  float lift_g;  float lift_b;  float lift_w;
    float gain_r;  float gain_g;  float gain_b;  float gain_w;
    float gam_r;   float gam_g;   float gam_b;   float gam_w;
    float saturation;
    float contrast;
    float grey;
    float saturation_out;
} pc;

vec4 lab_f(vec4 x) {
    vec4 eps = vec4(216.0 / 24389.0);
    vec4 k   = vec4(24389.0 / 27.0);
    bvec4 m = greaterThan(x, eps);
    vec4 a = vec4(pow(x.x, 1.0/3.0), pow(x.y, 1.0/3.0),
                  pow(x.z, 1.0/3.0), pow(x.w, 1.0/3.0));
    vec4 b = (k * x + vec4(16.0)) / vec4(116.0);
    return mix(b, a, m);
}
vec4 lab_f_inv(vec4 x) {
    vec4 eps = vec4(0.20689655172413796);
    vec4 k   = vec4(24389.0 / 27.0);
    bvec4 m = greaterThan(x, eps);
    vec4 a = x * x * x;
    vec4 b = (vec4(116.0) * x - vec4(16.0)) / k;
    return mix(b, a, m);
}
vec4 Lab_to_XYZ(vec4 Lab) {
    vec4 d50 = vec4(0.9642, 1.0, 0.8249, 0.0);
    vec4 f;
    f.y = (Lab.x + 16.0) / 116.0;
    f.x = Lab.y / 500.0 + f.y;
    f.z = f.y - Lab.z / 200.0;
    f.w = 0.0;
    vec4 xyz = d50 * lab_f_inv(f);
    xyz.w = Lab.w;
    return xyz;
}
vec4 XYZ_to_Lab(vec4 xyz) {
    vec4 d50i = vec4(1.0/0.9642, 1.0, 1.0/0.8249, 1.0);
    vec4 f = lab_f(xyz * d50i);
    vec4 lab;
    lab.x = 116.0 * f.y - 16.0;
    lab.y = 500.0 * (f.x - f.y);
    lab.z = 200.0 * (f.y - f.z);
    lab.w = xyz.w;
    return lab;
}
vec4 prophotorgb_to_XYZ(vec4 rgb) {
    vec4 XYZ = vec4(0.0, 0.0, 0.0, rgb.w);
    XYZ.x = 0.7976749 * rgb.x + 0.1351917 * rgb.y + 0.0313534 * rgb.z;
    XYZ.y = 0.2880402 * rgb.x + 0.7118741 * rgb.y + 0.0000857 * rgb.z;
    XYZ.z = 0.0000000 * rgb.x + 0.0000000 * rgb.y + 0.8252100 * rgb.z;
    return XYZ;
}
vec4 XYZ_to_prophotorgb(vec4 XYZ) {
    vec4 rgb = vec4(0.0, 0.0, 0.0, XYZ.w);
    rgb.x =  1.3459433 * XYZ.x - 0.2556075 * XYZ.y - 0.0511118 * XYZ.z;
    rgb.y = -0.5445989 * XYZ.x + 1.5081673 * XYZ.y + 0.0205351 * XYZ.z;
    rgb.z =  0.0000000 * XYZ.x + 0.0000000 * XYZ.y + 1.2118128 * XYZ.z;
    return rgb;
}
vec4 pow4(vec4 v, vec4 e) {
    return vec4(pow(v.x, e.x), pow(v.y, e.y), pow(v.z, e.z), v.w);
}

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if(x >= pc.width || y >= pc.height) return;
    int idx = y * pc.width + x;

    vec4 lift      = vec4(pc.lift_r, pc.lift_g, pc.lift_b, pc.lift_w);
    vec4 gain      = vec4(pc.gain_r, pc.gain_g, pc.gain_b, pc.gain_w);
    vec4 gamma_inv = vec4(pc.gam_r,  pc.gam_g,  pc.gam_b,  pc.gam_w);

    vec4 Lab = in_buf.data[idx];
    vec4 XYZ = Lab_to_XYZ(Lab);
    vec4 RGB = XYZ_to_prophotorgb(XYZ);

    if(pc.saturation != 1.0) {
        float luma = XYZ.y;
        RGB.x = luma + pc.saturation * (RGB.x - luma);
        RGB.y = luma + pc.saturation * (RGB.y - luma);
        RGB.z = luma + pc.saturation * (RGB.z - luma);
    }

    RGB = mix(vec4(0.0), pow4(RGB, vec4(1.0/2.2, 1.0/2.2, 1.0/2.2, 1.0)),
              vec4(greaterThan(RGB, vec4(0.0))));
    RGB = ((RGB - vec4(1.0)) * lift + vec4(1.0)) * gain;
    RGB = mix(vec4(0.0), pow4(RGB, gamma_inv * vec4(2.2, 2.2, 2.2, 1.0)),
              vec4(greaterThan(RGB, vec4(0.0))));

    if(pc.saturation_out != 1.0) {
        float luma = prophotorgb_to_XYZ(RGB).y;
        RGB.x = luma + pc.saturation_out * (RGB.x - luma);
        RGB.y = luma + pc.saturation_out * (RGB.y - luma);
        RGB.z = luma + pc.saturation_out * (RGB.z - luma);
    }

    if(pc.contrast != 1.0) {
        vec4 contrast4 = vec4(pc.contrast);
        vec4 grey4     = vec4(pc.grey);
        RGB = mix(vec4(0.0), pow4(RGB / grey4, contrast4) * grey4,
                  vec4(greaterThan(RGB, vec4(0.0))));
    }

    vec4 lab = XYZ_to_Lab(prophotorgb_to_XYZ(RGB));
    Lab.x = lab.x; Lab.y = lab.y; Lab.z = lab.z;
    out_buf.data[idx] = Lab;
}
