// GLSL fallback for colisa.cl. Single entry point — same 4-binding
// shape as the clspv path (in, out, ctable, ltable storage buffers).
//
// Push-constant layout is laid out scalar-by-scalar so it matches
// the clspv path byte-for-byte at 36 bytes (no vec4 alignment holes).

#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(std430, binding = 0) readonly buffer In     { vec4  data[]; } in_buf;
layout(std430, binding = 1)          buffer Out    { vec4  data[]; } out_buf;
layout(std430, binding = 2) readonly buffer Ctable { float data[]; } ctable_buf;
layout(std430, binding = 3) readonly buffer Ltable { float data[]; } ltable_buf;

layout(push_constant) uniform PC {
    int   width;
    int   height;
    float saturation;
    float ca0;
    float ca1;
    float ca2;
    float la0;
    float la1;
    float la2;
} pc;

const int VK_LUT_SIZE = 0x10000;  // 65536 — matches dt_vulkan_common.h

float vk_lookup_unbounded_g(float x, float c0, float c1, float c2, int which) {
    if (c0 < 0.0) return x;
    if (x < 1.0) {
        int xi = clamp(int(x * float(VK_LUT_SIZE)), 0, VK_LUT_SIZE - 1);
        return (which == 0) ? ctable_buf.data[xi] : ltable_buf.data[xi];
    }
    return c1 * pow(x * c0, c2);
}

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if (x >= pc.width || y >= pc.height) return;
    int i = y * pc.width + x;

    vec4 p = in_buf.data[i];
    vec4 o;
    float L = vk_lookup_unbounded_g(p.x / 100.0, pc.ca0, pc.ca1, pc.ca2, 0);
    o.x = vk_lookup_unbounded_g(L / 100.0, pc.la0, pc.la1, pc.la2, 1);
    o.y = p.y * pc.saturation;
    o.z = p.z * pc.saturation;
    o.w = p.w;
    out_buf.data[i] = o;
}
