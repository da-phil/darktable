// GLSL fallback for blurs_restore_alpha.cl.

#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(std430, binding = 0) readonly buffer Orig { vec4 data[]; } original;
layout(std430, binding = 1) readonly buffer Blur { vec4 data[]; } blurred;
layout(std430, binding = 2)          buffer Out  { vec4 data[]; } out_buf;
layout(push_constant) uniform PC {
    int width;
    int height;
} pc;

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if (x >= pc.width || y >= pc.height) return;
    int idx = y * pc.width + x;

    vec4 px = blurred.data[idx];
    px.w = original.data[idx].w;
    out_buf.data[idx] = px;
}
