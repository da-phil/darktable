// GLSL twin of exposure.cl. Used by the CMake build when clspv isn't
// installed. Must stay behaviour-equivalent — if exposure.cl changes,
// mirror the change here.

#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly  buffer In  { vec4 data[]; } in_buf;
layout(std430, binding = 1)           buffer Out { vec4 data[]; } out_buf;

layout(push_constant) uniform Params {
    int   width;
    int   height;
    float black;
    float scale;
} pc;

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if (x >= pc.width || y >= pc.height) return;

    int idx = y * pc.width + x;
    vec4 pixel = in_buf.data[idx];
    pixel.rgb = (pixel.rgb - vec3(pc.black)) * pc.scale;
    out_buf.data[idx] = pixel;
}
