// GLSL fallback for guided_filter_split_rgb.cl.

#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(std430, binding = 0) readonly buffer Guide { vec4  data[]; } guide;
layout(std430, binding = 1)          buffer OutR  { float data[]; } out_r;
layout(std430, binding = 2)          buffer OutG  { float data[]; } out_g;
layout(std430, binding = 3)          buffer OutB  { float data[]; } out_b;
layout(push_constant) uniform PC {
    int   width;
    int   height;
    int   first;
    float guide_weight;
} pc;

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if (x >= pc.width || y >= pc.height) return;
    int idx = y * pc.width + x;

    vec4 g = min(vec4(100.0), guide.data[(y + pc.first) * pc.width + x]);
    out_r.data[idx] = pc.guide_weight * g.x;
    out_g.data[idx] = pc.guide_weight * g.y;
    out_b.data[idx] = pc.guide_weight * g.z;
}
