// GLSL fallback for channelmixer.cl.

#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer In  { vec4  data[]; } in_buf;
layout(std430, binding = 1)          buffer Out { vec4  data[]; } out_buf;
layout(std430, binding = 2) readonly buffer HSL { float data[]; } hsl_matrix;
layout(std430, binding = 3) readonly buffer RGB { float data[]; } rgb_matrix;

layout(push_constant) uniform PC {
    int width;
    int height;
    int operation_mode;
} pc;

#define OPERATION_MODE_RGB    0
#define OPERATION_MODE_GRAY   1
#define OPERATION_MODE_HSL_V1 2
#define OPERATION_MODE_HSL_V2 3

float clipf(float v) { return clamp(v, 0.0, 1.0); }

vec4 rgb_to_hsl(vec4 RGB) {
    float H = 0.0, S = 0.0;
    float R = RGB.x, G = RGB.y, B = RGB.z;
    float var_Min = min(R, min(G, B));
    float var_Max = max(R, max(G, B));
    float del_Max = var_Max - var_Min;
    float L = (var_Max + var_Min) * 0.5;

    if(abs(var_Max) > 1e-6 && abs(del_Max) > 1e-6) {
        S = (L < 0.5) ? del_Max / (var_Max + var_Min)
                      : del_Max / (2.0 - var_Max - var_Min);
        float del_R = (((var_Max - R) / 6.0) + (del_Max / 2.0)) / del_Max;
        float del_G = (((var_Max - G) / 6.0) + (del_Max / 2.0)) / del_Max;
        float del_B = (((var_Max - B) / 6.0) + (del_Max / 2.0)) / del_Max;

        if(R == var_Max)      H = del_B - del_G;
        else if(G == var_Max) H = (1.0/3.0) + del_R - del_B;
        else if(B == var_Max) H = (2.0/3.0) + del_G - del_R;

        if(H < 0.0) H += 1.0;
        if(H > 1.0) H -= 1.0;
    }
    return vec4(H, S, L, RGB.w);
}

float hue_to_rgb(float v1, float v2, float vH) {
    if(vH < 0.0) vH += 1.0;
    if(vH > 1.0) vH -= 1.0;
    if(6.0 * vH < 1.0) return v1 + (v2 - v1) * 6.0 * vH;
    if(2.0 * vH < 1.0) return v2;
    if(3.0 * vH < 2.0) return v1 + (v2 - v1) * ((2.0/3.0) - vH) * 6.0;
    return v1;
}

vec4 hsl_to_rgb(vec4 HSL) {
    float H = HSL.x, S = HSL.y, L = HSL.z;
    if(S < 1e-6) return vec4(L, L, L, HSL.w);
    float var_2 = (L < 0.5) ? L * (1.0 + S) : (L + S) - (S * L);
    float var_1 = 2.0 * L - var_2;
    return vec4(hue_to_rgb(var_1, var_2, H + 1.0/3.0),
                hue_to_rgb(var_1, var_2, H),
                hue_to_rgb(var_1, var_2, H - 1.0/3.0),
                HSL.w);
}

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if(x >= pc.width || y >= pc.height) return;
    int idx = y * pc.width + x;

    vec4 pixel = in_buf.data[idx];
    vec4 opixel = vec4(0.0, 0.0, 0.0, pixel.w);
    float gray, hmix, smix, lmix;

    switch(pc.operation_mode)
    {
        case OPERATION_MODE_RGB:
            opixel.x = max(pixel.x * rgb_matrix.data[0] + pixel.y * rgb_matrix.data[1] + pixel.z * rgb_matrix.data[2], 0.0);
            opixel.y = max(pixel.x * rgb_matrix.data[3] + pixel.y * rgb_matrix.data[4] + pixel.z * rgb_matrix.data[5], 0.0);
            opixel.z = max(pixel.x * rgb_matrix.data[6] + pixel.y * rgb_matrix.data[7] + pixel.z * rgb_matrix.data[8], 0.0);
            break;

        case OPERATION_MODE_GRAY:
            gray = max(pixel.x * rgb_matrix.data[0] + pixel.y * rgb_matrix.data[1] + pixel.z * rgb_matrix.data[2], 0.0);
            opixel = vec4(gray, gray, gray, pixel.w);
            break;

        case OPERATION_MODE_HSL_V1:
            hmix = clipf(pixel.x * hsl_matrix.data[0]) + pixel.y * hsl_matrix.data[1] + pixel.z * hsl_matrix.data[2];
            smix = clipf(pixel.x * hsl_matrix.data[3]) + pixel.y * hsl_matrix.data[4] + pixel.z * hsl_matrix.data[5];
            lmix = clipf(pixel.x * hsl_matrix.data[6]) + pixel.y * hsl_matrix.data[7] + pixel.z * hsl_matrix.data[8];

            if(hmix != 0.0 || smix != 0.0 || lmix != 0.0) {
                vec4 hsl = rgb_to_hsl(pixel);
                hsl.x = (hmix != 0.0) ? hmix : hsl.x;
                hsl.y = (smix != 0.0) ? smix : hsl.y;
                hsl.z = (lmix != 0.0) ? lmix : hsl.z;
                pixel = hsl_to_rgb(hsl);
            }
            opixel.x = clipf(pixel.x * rgb_matrix.data[0] + pixel.y * rgb_matrix.data[1] + pixel.z * rgb_matrix.data[2]);
            opixel.y = clipf(pixel.x * rgb_matrix.data[3] + pixel.y * rgb_matrix.data[4] + pixel.z * rgb_matrix.data[5]);
            opixel.z = clipf(pixel.x * rgb_matrix.data[6] + pixel.y * rgb_matrix.data[7] + pixel.z * rgb_matrix.data[8]);
            break;

        case OPERATION_MODE_HSL_V2:
            hmix = clipf(pixel.x * hsl_matrix.data[0] + pixel.y * hsl_matrix.data[1] + pixel.z * hsl_matrix.data[2]);
            smix = clipf(pixel.x * hsl_matrix.data[3] + pixel.y * hsl_matrix.data[4] + pixel.z * hsl_matrix.data[5]);
            lmix = clipf(pixel.x * hsl_matrix.data[6] + pixel.y * hsl_matrix.data[7] + pixel.z * hsl_matrix.data[8]);
            if(hmix != 0.0 || smix != 0.0 || lmix != 0.0) {
                pixel = vec4(clipf(pixel.x), clipf(pixel.y), clipf(pixel.z), pixel.w);
                vec4 hsl = rgb_to_hsl(pixel);
                hsl.x = (hmix != 0.0) ? hmix : hsl.x;
                hsl.y = (smix != 0.0) ? smix : hsl.y;
                hsl.z = (lmix != 0.0) ? lmix : hsl.z;
                pixel = hsl_to_rgb(hsl);
            }
            opixel.x = max(pixel.x * rgb_matrix.data[0] + pixel.y * rgb_matrix.data[1] + pixel.z * rgb_matrix.data[2], 0.0);
            opixel.y = max(pixel.x * rgb_matrix.data[3] + pixel.y * rgb_matrix.data[4] + pixel.z * rgb_matrix.data[5], 0.0);
            opixel.z = max(pixel.x * rgb_matrix.data[6] + pixel.y * rgb_matrix.data[7] + pixel.z * rgb_matrix.data[8], 0.0);
            break;
    }

    out_buf.data[idx] = opixel;
}
