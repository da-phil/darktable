// GLSL fallback for hazeremoval_transision_map.cl.

#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(std430, binding = 0) readonly buffer In  { vec4  data[]; } in_buf;
layout(std430, binding = 1)          buffer Out { float data[]; } out_buf;
layout(push_constant) uniform PC {
    int   width;
    int   height;
    float strength;
    float A0_r;
    float A0_g;
    float A0_b;
} pc;

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if (x >= pc.width || y >= pc.height) return;
    int idx = y * pc.width + x;

    vec4 p = in_buf.data[idx];
    float m = p.x / pc.A0_r;
    m = min(p.y / pc.A0_g, m);
    m = min(p.z / pc.A0_b, m);
    out_buf.data[idx] = 1.0 - m * pc.strength;
}
