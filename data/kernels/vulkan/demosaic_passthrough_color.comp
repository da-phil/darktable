#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(std430, binding = 0) readonly buffer In  { float data[]; } in_buf;
layout(std430, binding = 1)          buffer Out { vec4  data[]; } out_buf;
layout(std430, binding = 2) readonly buffer Xtr { uint  data[]; } xtrans_buf;
layout(push_constant) uniform PC {
  int width; int height; uint filters;
} pc;

int vk_FC(int row, int col, uint filters) {
  return int((filters >> uint((((row << 1) & 14) + (col & 1)) << 1)) & 3u);
}
int vk_FCxtrans(int row, int col) {
  return int(xtrans_buf.data[((row + 600) % 6) * 6 + ((col + 600) % 6)]);
}

void main() {
  int x = int(gl_GlobalInvocationID.x);
  int y = int(gl_GlobalInvocationID.y);
  if(x >= pc.width || y >= pc.height) return;
  int idx = y * pc.width + x;
  float v = in_buf.data[idx];
  int c = (pc.filters == 9u) ? vk_FCxtrans(y, x) : vk_FC(y, x, pc.filters);
  vec4 o = vec4(0.0);
  if(c == 0)      o.x = v;
  else if(c == 1) o.y = v;
  else            o.z = v;
  out_buf.data[idx] = o;
}
