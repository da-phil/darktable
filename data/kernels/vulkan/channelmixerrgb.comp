// GLSL fallback for channelmixerrgb.cl::channelmixerrgb.
//
// Like the clspv kernel, one entry point switches on pc.adaptation at
// runtime, so glslang builds cover all five adaptation modes (linear
// Bradford, CAT16, full Bradford, XYZ, RGB bypass). The switch is
// uniform across the dispatch — every invocation reads the same push
// constant — so there is no divergence cost.

#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(std430, binding = 0) readonly buffer In  { vec4 data[];  } in_buf;
layout(std430, binding = 1)          buffer Out { vec4 data[];  } out_buf;
layout(std430, binding = 2) readonly buffer Mat { float data[]; } mat_buf;

// Adaptation enum — values match dt_adaptation_t / VK_ADAPT_*.
const int ADAPT_LINEAR_BRADFORD = 0;
const int ADAPT_CAT16           = 1;
const int ADAPT_FULL_BRADFORD   = 2;
const int ADAPT_XYZ             = 3;
const int ADAPT_RGB             = 4;

// Scalar layout (no vec4 padding) so this matches the C-side
// vk_chmix_pc_t byte-for-byte: 6 ints + 2 floats + 4 float[4] arrays =
// 96 bytes. Using vec4 here forces std430 16-byte alignment and
// silently shifts illuminant from offset 32 to offset 48, corrupting
// every read from this PC block under the glslang fallback path.
layout(push_constant) uniform PC {
    int   width;
    int   height;
    int   version;
    int   clip;
    int   apply_grey;
    int   adaptation;
    float p;
    float gamut;
    float illuminant[4];
    float saturation[4];
    float lightness[4];
    float grey[4];
} pc;

// Helpers to read the float[4] arrays back as vec4s — keeps the rest
// of the kernel body unchanged.
vec4 pc_illuminant(void) { return vec4(pc.illuminant[0], pc.illuminant[1], pc.illuminant[2], pc.illuminant[3]); }
vec4 pc_saturation(void) { return vec4(pc.saturation[0], pc.saturation[1], pc.saturation[2], pc.saturation[3]); }
vec4 pc_lightness(void)  { return vec4(pc.lightness[0],  pc.lightness[1],  pc.lightness[2],  pc.lightness[3]); }
vec4 pc_grey(void)       { return vec4(pc.grey[0],       pc.grey[1],       pc.grey[2],       pc.grey[3]); }

const float NORM_MIN       = 1.52587890625e-05;
const float INVERSE_SQRT_3 = 0.5773502691896258;

float sqf(float x) { return x * x; }
float euclidean_norm4(vec4 v) {
    return max(sqrt(sqf(v.x) + sqf(v.y) + sqf(v.z)), NORM_MIN);
}

vec4 matmul_padded(vec4 v, int off) {
    return vec4(mat_buf.data[off+0] * v.x + mat_buf.data[off+1]  * v.y + mat_buf.data[off+2]  * v.z,
                mat_buf.data[off+4] * v.x + mat_buf.data[off+5]  * v.y + mat_buf.data[off+6]  * v.z,
                mat_buf.data[off+8] * v.x + mat_buf.data[off+9]  * v.y + mat_buf.data[off+10] * v.z,
                v.w);
}

vec4 XYZ_to_bradford_LMS(vec4 v) {
    return vec4( 0.8951 * v.x + 0.2664 * v.y - 0.1614 * v.z,
                -0.7502 * v.x + 1.7135 * v.y + 0.0367 * v.z,
                 0.0389 * v.x - 0.0685 * v.y + 1.0296 * v.z,
                 v.w);
}
vec4 bradford_LMS_to_XYZ(vec4 v) {
    return vec4( 0.9870 * v.x - 0.1471 * v.y + 0.1600 * v.z,
                 0.4323 * v.x + 0.5184 * v.y + 0.0493 * v.z,
                -0.0085 * v.x + 0.0400 * v.y + 0.9685 * v.z,
                 v.w);
}
vec4 XYZ_to_CAT16_LMS(vec4 v) {
    return vec4( 0.401288 * v.x + 0.650173 * v.y - 0.051461 * v.z,
                -0.250268 * v.x + 1.204414 * v.y + 0.045854 * v.z,
                -0.002079 * v.x + 0.048952 * v.y + 0.953127 * v.z,
                 v.w);
}
vec4 CAT16_LMS_to_XYZ(vec4 v) {
    return vec4( 1.862068 * v.x - 1.011255 * v.y + 0.149187 * v.z,
                 0.38752  * v.x + 0.621447 * v.y - 0.008974 * v.z,
                -0.015841 * v.x - 0.034123 * v.y + 1.049964 * v.z,
                 v.w);
}

vec4 bradford_adapt_D50(vec4 lms, vec4 origin, float p, bool full) {
    vec4 D50 = vec4(0.996078, 1.020646, 0.818155, 0.0);
    if (full) {
        vec4 t = lms / origin;
        t.z = (t.z > 0.0) ? pow(t.z, p) : t.z;
        return D50 * t;
    }
    return lms * (D50 / origin);
}

vec4 CAT16_adapt_D50(vec4 lms, vec4 origin, float D, bool full) {
    vec4 D50 = vec4(0.994535, 1.000997, 0.833036, 0.0);
    if (full) return lms * (D50 / origin);
    return lms * (D * D50 / origin + vec4(1.0 - D));
}

vec4 XYZ_adapt_D50(vec4 v, vec4 origin) {
    vec4 D50 = vec4(0.9642119944211994, 1.0, 0.8251882845188288, 0.0);
    return v * (D50 / origin);
}

vec4 chroma_adapt_bradford(vec4 RGB, vec4 illuminant, float p, bool full) {
    vec4 XYZ = matmul_padded(RGB, 0);
    float Y = XYZ.y;
    vec4 LMS = XYZ_to_bradford_LMS(XYZ);
    float s = (Y > NORM_MIN && !isnan(Y)) ? (Y + NORM_MIN) : NORM_MIN;
    LMS /= s;
    LMS = bradford_adapt_D50(LMS, illuminant, p, full);
    LMS *= s;
    vec4 LMS_mixed = matmul_padded(LMS, 24);
    return bradford_LMS_to_XYZ(LMS_mixed);
}

vec4 chroma_adapt_CAT16(vec4 RGB, vec4 illuminant, float D, bool full) {
    vec4 XYZ = matmul_padded(RGB, 0);
    float Y = XYZ.y;
    vec4 LMS = XYZ_to_CAT16_LMS(XYZ);
    float s = (Y > NORM_MIN && !isnan(Y)) ? (Y + NORM_MIN) : NORM_MIN;
    LMS /= s;
    LMS = CAT16_adapt_D50(LMS, illuminant, D, full);
    LMS *= s;
    vec4 LMS_mixed = matmul_padded(LMS, 24);
    return CAT16_LMS_to_XYZ(LMS_mixed);
}

vec4 chroma_adapt_XYZ(vec4 RGB, vec4 illuminant) {
    vec4 XYZ = matmul_padded(RGB, 0);
    float Y = XYZ.y;
    float s = (Y > NORM_MIN && !isnan(Y)) ? (Y + NORM_MIN) : NORM_MIN;
    XYZ /= s;
    XYZ = XYZ_adapt_D50(XYZ, illuminant);
    XYZ *= s;
    return matmul_padded(XYZ, 24);
}

vec4 chroma_adapt_RGB(vec4 RGB) {
    vec4 RGB_mixed = matmul_padded(RGB, 24);
    return matmul_padded(RGB_mixed, 0);
}

vec4 xyY_to_uvY(vec4 xyY) {
    float den = -2.0 * xyY.x + 12.0 * xyY.y + 3.0;
    return vec4(4.0 * xyY.x / den, 9.0 * xyY.y / den, xyY.z, xyY.w);
}
vec4 uvY_to_xyY(vec4 uvY) {
    float den = 6.0 * uvY.x - 16.0 * uvY.y + 12.0;
    return vec4(9.0 * uvY.x / den, 4.0 * uvY.y / den, uvY.z, uvY.w);
}
vec4 xyY_to_XYZ(vec4 xyY) {
    vec4 XYZ = vec4(0.0, 0.0, 0.0, xyY.w);
    if (xyY.y != 0.0) {
        XYZ.x = xyY.z * xyY.x / xyY.y;
        XYZ.y = xyY.z;
        XYZ.z = xyY.z * (1.0 - xyY.x - xyY.y) / xyY.y;
    }
    return XYZ;
}

vec4 gamut_mapping(vec4 input_v, float compression, bool clip) {
    float sum = input_v.x + input_v.y + input_v.z;
    float Y = input_v.y;
    vec4 xyY = vec4(sum > 0.0 ? input_v.x / sum : 0.34567,
                    sum > 0.0 ? input_v.y / sum : 0.35850,
                    Y, 0.0);
    vec4 uvY = xyY_to_uvY(xyY);
    vec2 D50 = vec2(0.20915914598542354, 0.488075320769787);
    vec2 delta = D50 - uvY.xy;
    float Delta = Y * (sqf(delta.x) + sqf(delta.y));
    float correction = (compression == 0.0) ? 0.0 : pow(Delta, compression);
    vec2 tmp = correction * delta + uvY.xy;
    bvec2 gt = greaterThan(uvY.xy, D50);
    uvY.xy = mix(min(tmp, D50), max(tmp, D50), gt);
    xyY = uvY_to_xyY(uvY);
    if (clip) xyY.xy = max(xyY.xy, vec2(0.0));
    xyY.y = max(xyY.y, NORM_MIN);
    float scale = xyY.x + xyY.y;
    if (scale >= 1.0) xyY.xy /= scale;
    return xyY_to_XYZ(xyY);
}

vec4 luma_chroma(vec4 input_v, vec4 saturation, vec4 lightness, int version) {
    float norm = euclidean_norm4(input_v);
    float avg = max((input_v.x + input_v.y + input_v.z) / 3.0, NORM_MIN);
    if (!(norm > 0.0 && avg > 0.0)) return input_v;

    float mixv = dot(input_v, lightness);
    if (version == 2) norm *= INVERSE_SQRT_3;
    vec4 output_v = input_v / vec4(norm);
    float coeff_ratio = (version == 0)
                        ? dot(vec4(1.0) - output_v, saturation)
                        : dot(output_v, saturation) / 3.0;
    vec4 min_ratio = mix(vec4(0.0), output_v, lessThan(output_v, vec4(0.0)));
    vec4 output_inv = vec4(1.0) - output_v;
    output_v = max(output_inv * coeff_ratio + output_v, min_ratio);
    if (version == 2) norm /= euclidean_norm4(output_v) * INVERSE_SQRT_3;
    norm *= max(1.0 + mixv / avg, 0.0);
    return output_v * vec4(norm);
}

// XYZ → working space (adaptation's LMS / XYZ / pipe RGB) and back;
// mirrors the switches inside channelmixerrgb.cl::vk_chmix_finalize.
vec4 XYZ_to_working(vec4 XYZ, int adaptation) {
    switch (adaptation) {
        case ADAPT_FULL_BRADFORD:
        case ADAPT_LINEAR_BRADFORD: return XYZ_to_bradford_LMS(XYZ);
        case ADAPT_CAT16:           return XYZ_to_CAT16_LMS(XYZ);
        case ADAPT_XYZ:             return XYZ;
        default:                    return matmul_padded(XYZ, 12);  // XYZ_to_RGB
    }
}
vec4 working_to_XYZ(vec4 LMS, int adaptation) {
    switch (adaptation) {
        case ADAPT_FULL_BRADFORD:
        case ADAPT_LINEAR_BRADFORD: return bradford_LMS_to_XYZ(LMS);
        case ADAPT_CAT16:           return CAT16_LMS_to_XYZ(LMS);
        case ADAPT_XYZ:             return LMS;
        default:                    return matmul_padded(LMS, 0);   // RGB_to_XYZ
    }
}

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if (x >= pc.width || y >= pc.height) return;
    int idx = y * pc.width + x;

    vec4 pix_in = in_buf.data[idx];
    vec4 RGB = pix_in;
    RGB.w = 0.0;
    if (pc.clip != 0) RGB = max(RGB, vec4(0.0));

    vec4 XYZ;
    switch (pc.adaptation) {
        case ADAPT_FULL_BRADFORD:
            XYZ = chroma_adapt_bradford(RGB, pc_illuminant(), pc.p, true);
            break;
        case ADAPT_LINEAR_BRADFORD:
            XYZ = chroma_adapt_bradford(RGB, pc_illuminant(), pc.p, false);
            break;
        case ADAPT_CAT16:
            XYZ = chroma_adapt_CAT16(RGB, pc_illuminant(), 1.0, false);
            break;
        case ADAPT_XYZ:
            XYZ = chroma_adapt_XYZ(RGB, pc_illuminant());
            break;
        default:
            XYZ = chroma_adapt_RGB(RGB);
            break;
    }
    if (pc.clip != 0) XYZ = max(XYZ, vec4(0.0));
    XYZ = gamut_mapping(XYZ, pc.gamut, pc.clip != 0);

    vec4 LMS = XYZ_to_working(XYZ, pc.adaptation);
    if (pc.clip != 0) LMS = max(LMS, vec4(0.0));
    LMS = luma_chroma(LMS, pc_saturation(), pc_lightness(), pc.version);
    if (pc.clip != 0) LMS = max(LMS, vec4(0.0));

    vec4 RGB_out;
    if (pc.apply_grey != 0) {
        float grey_mix = max(dot(LMS, pc_grey()), 0.0);
        RGB_out = vec4(grey_mix, grey_mix, grey_mix, pix_in.w);
    } else {
        XYZ = working_to_XYZ(LMS, pc.adaptation);
        if (pc.clip != 0) XYZ = max(XYZ, vec4(0.0));
        RGB_out = matmul_padded(XYZ, 12);  // XYZ_to_RGB
        if (pc.clip != 0) RGB_out = max(RGB_out, vec4(0.0));
        RGB_out.w = pix_in.w;
    }
    out_buf.data[idx] = RGB_out;
}
