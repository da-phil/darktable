// GLSL fallback for colorcontrast.cl.

#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(std430, binding = 0) readonly  buffer In  { vec4 data[]; } in_buf;
layout(std430, binding = 1)           buffer Out { vec4 data[]; } out_buf;
layout(push_constant) uniform PC {
    int   width;
    int   height;
    float scale_l;
    float scale_a;
    float scale_b;
    float offset_l;
    float offset_a;
    float offset_b;
    int   unbound;
} pc;

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if (x >= pc.width || y >= pc.height) return;
    int i = y * pc.width + x;
    vec4 p = in_buf.data[i];

    vec4 o;
    o.x = p.x * pc.scale_l + pc.offset_l;
    o.y = p.y * pc.scale_a + pc.offset_a;
    o.z = p.z * pc.scale_b + pc.offset_b;
    o.w = p.w;
    if (pc.unbound == 0) {
        o.y = clamp(o.y, -128.0, 128.0);
        o.z = clamp(o.z, -128.0, 128.0);
    }
    out_buf.data[i] = o;
}
