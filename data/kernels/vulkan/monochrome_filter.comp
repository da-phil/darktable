// GLSL fallback for monochrome_filter.cl.
#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer In  { vec4 data[]; } in_buf;
layout(std430, binding = 1)          buffer Out { vec4 data[]; } out_buf;

layout(push_constant) uniform PC {
    int   width;
    int   height;
    float a;
    float b;
    float size;
} pc;

float fast_expf(float x) {
    int i1 = 0x3f800000;
    int i2 = 0x402DF854;
    int k0 = i1 + int(x * float(i2 - i1));
    return uintBitsToFloat(uint(k0 > 0 ? k0 : 0));
}

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if(x >= pc.width || y >= pc.height) return;
    int idx = y * pc.width + x;

    vec4 pixel = in_buf.data[idx];
    float da = pixel.y - pc.a;
    float db = pixel.z - pc.b;
    pixel.x = 100.0 * fast_expf(-clamp((da * da + db * db) / (2.0 * pc.size), 0.0, 1.0));
    out_buf.data[idx] = pixel;
}
