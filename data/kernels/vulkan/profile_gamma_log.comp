// GLSL fallback for profile_gamma_log.cl.

#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(std430, binding = 0) readonly  buffer In  { vec4 data[]; } in_buf;
layout(std430, binding = 1)           buffer Out { vec4 data[]; } out_buf;
layout(push_constant) uniform PC {
    int width;
    int height;
    float dynamic_range;
    float shadows_range;
    float grey;
} pc;

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if (x >= pc.width || y >= pc.height) return;
    int idx = y * pc.width + x;
    vec4 i = in_buf.data[idx];

    vec4 noise = vec4(pow(2.0, -16.0));
    vec4 grey4 = vec4(pc.grey);
    vec4 o = mix(i / grey4, noise, lessThan(i, noise));
    o = (log2(o) - vec4(pc.shadows_range)) / vec4(pc.dynamic_range);
    o = mix(o, noise, lessThan(o, noise));
    i.xyz = o.xyz;
    out_buf.data[idx] = i;
}
