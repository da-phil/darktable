// GLSL fallback for colorbalance.cl (LEGACY variant).
#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer In  { vec4 data[]; } in_buf;
layout(std430, binding = 1)          buffer Out { vec4 data[]; } out_buf;

layout(push_constant) uniform PC {
    int   width;
    int   height;
    float lift_r;  float lift_g;  float lift_b;  float lift_w;
    float gain_r;  float gain_g;  float gain_b;  float gain_w;
    float gam_r;   float gam_g;   float gam_b;   float gam_w;
    float saturation;
    float contrast;
    float grey;
} pc;

vec4 lab_f(vec4 x) {
    vec4 eps = vec4(216.0 / 24389.0);
    vec4 k   = vec4(24389.0 / 27.0);
    bvec4 m = greaterThan(x, eps);
    vec4 a = vec4(pow(x.x, 1.0/3.0), pow(x.y, 1.0/3.0),
                  pow(x.z, 1.0/3.0), pow(x.w, 1.0/3.0));
    vec4 b = (k * x + vec4(16.0)) / vec4(116.0);
    return mix(b, a, m);
}
vec4 lab_f_inv(vec4 x) {
    vec4 eps = vec4(0.20689655172413796);
    vec4 k   = vec4(24389.0 / 27.0);
    bvec4 m = greaterThan(x, eps);
    vec4 a = x * x * x;
    vec4 b = (vec4(116.0) * x - vec4(16.0)) / k;
    return mix(b, a, m);
}
vec4 Lab_to_XYZ(vec4 Lab) {
    vec4 d50 = vec4(0.9642, 1.0, 0.8249, 0.0);
    vec4 f;
    f.y = (Lab.x + 16.0) / 116.0;
    f.x = Lab.y / 500.0 + f.y;
    f.z = f.y - Lab.z / 200.0;
    f.w = 0.0;
    vec4 xyz = d50 * lab_f_inv(f);
    xyz.w = Lab.w;
    return xyz;
}
vec4 XYZ_to_Lab(vec4 xyz) {
    vec4 d50i = vec4(1.0/0.9642, 1.0, 1.0/0.8249, 1.0);
    vec4 f = lab_f(xyz * d50i);
    vec4 lab;
    lab.x = 116.0 * f.y - 16.0;
    lab.y = 500.0 * (f.x - f.y);
    lab.z = 200.0 * (f.y - f.z);
    lab.w = xyz.w;
    return lab;
}
vec4 XYZ_to_sRGB(vec4 XYZ) {
    vec4 sRGB;
    sRGB.x =  3.1338561 * XYZ.x - 1.6168667 * XYZ.y - 0.4906146 * XYZ.z;
    sRGB.y = -0.9787684 * XYZ.x + 1.9161415 * XYZ.y + 0.0334540 * XYZ.z;
    sRGB.z =  0.0719453 * XYZ.x - 0.2289914 * XYZ.y + 1.4052427 * XYZ.z;
    sRGB.w = XYZ.w;
    return sRGB;
}
vec4 sRGB_to_XYZ(vec4 sRGB) {
    vec4 XYZ;
    XYZ.x = 0.4360747 * sRGB.x + 0.3850649 * sRGB.y + 0.1430804 * sRGB.z;
    XYZ.y = 0.2225045 * sRGB.x + 0.7168786 * sRGB.y + 0.0606169 * sRGB.z;
    XYZ.z = 0.0139322 * sRGB.x + 0.0971045 * sRGB.y + 0.7141733 * sRGB.z;
    XYZ.w = sRGB.w;
    return XYZ;
}
vec4 pow4(vec4 v, vec4 e) {
    return vec4(pow(v.x, e.x), pow(v.y, e.y), pow(v.z, e.z), v.w);
}

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if(x >= pc.width || y >= pc.height) return;
    int idx = y * pc.width + x;

    vec4 lift      = vec4(pc.lift_r, pc.lift_g, pc.lift_b, pc.lift_w);
    vec4 gain      = vec4(pc.gain_r, pc.gain_g, pc.gain_b, pc.gain_w);
    vec4 gamma_inv = vec4(pc.gam_r,  pc.gam_g,  pc.gam_b,  pc.gam_w);

    vec4 Lab  = in_buf.data[idx];
    vec4 sRGB = XYZ_to_sRGB(Lab_to_XYZ(Lab));

    sRGB = mix(12.92 * sRGB,
               (1.0 + 0.055) * pow4(sRGB, vec4(1.0/2.4, 1.0/2.4, 1.0/2.4, 1.0)) - vec4(0.055),
               vec4(greaterThan(sRGB, vec4(0.0031308))));
    sRGB = pow4(max(((sRGB - vec4(1.0)) * lift + vec4(1.0)) * gain, vec4(0.0)), gamma_inv);
    sRGB = mix(sRGB / 12.92,
               pow4((sRGB + vec4(0.055)) / (1.0 + 0.055), vec4(2.4, 2.4, 2.4, 1.0)),
               vec4(greaterThan(sRGB, vec4(0.04045))));

    vec4 lab = XYZ_to_Lab(sRGB_to_XYZ(sRGB));
    Lab.x = lab.x; Lab.y = lab.y; Lab.z = lab.z;
    out_buf.data[idx] = Lab;
}
