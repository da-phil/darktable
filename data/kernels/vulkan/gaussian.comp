// GLSL fallback for gaussian.cl. Single entry — glslang exposes one
// kernel per .spv module, so we ship the column blur here (the row
// blur uses the same recurrence with axes swapped and is unreachable
// from the glslang path; modules that need full 2-axis blurring fall
// back to OpenCL/CPU under the glslang fallback build).
//
// Push-constant layout is laid out scalar-by-scalar so it matches the
// clspv path byte-for-byte at 72 bytes (no vec4 alignment holes).

#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(std430, binding = 0) readonly buffer In  { vec4 data[]; } in_buf;
layout(std430, binding = 1)          buffer Out { vec4 data[]; } out_buf;

layout(push_constant) uniform PC {
    int   width;
    int   height;
    float a0;
    float a1;
    float a2;
    float a3;
    float b1;
    float b2;
    float coefp;
    float coefn;
    float Labmax_r;
    float Labmax_g;
    float Labmax_b;
    float Labmax_a;
    float Labmin_r;
    float Labmin_g;
    float Labmin_b;
    float Labmin_a;
} pc;

void main() {
    int x = int(gl_GlobalInvocationID.x);
    if (x >= pc.width) return;

    vec4 Labmax = vec4(pc.Labmax_r, pc.Labmax_g, pc.Labmax_b, pc.Labmax_a);
    vec4 Labmin = vec4(pc.Labmin_r, pc.Labmin_g, pc.Labmin_b, pc.Labmin_a);

    vec4 xp = clamp(in_buf.data[x], Labmin, Labmax);
    vec4 yb = xp * pc.coefp;
    vec4 yp = yb;

    for (int y = 0; y < pc.height; y++) {
        int idx = y * pc.width + x;
        vec4 xc = clamp(in_buf.data[idx], Labmin, Labmax);
        vec4 yc = (pc.a0 * xc) + (pc.a1 * xp) - (pc.b1 * yp) - (pc.b2 * yb);
        xp = xc; yb = yp; yp = yc;
        out_buf.data[idx] = yc;
    }

    vec4 xn = clamp(in_buf.data[(pc.height - 1) * pc.width + x], Labmin, Labmax);
    vec4 xa = xn;
    vec4 yn = xn * pc.coefn;
    vec4 ya = yn;

    for (int y = pc.height - 1; y >= 0; y--) {
        int idx = y * pc.width + x;
        vec4 xc = clamp(in_buf.data[idx], Labmin, Labmax);
        vec4 yc = (pc.a2 * xn) + (pc.a3 * xa) - (pc.b1 * yn) - (pc.b2 * ya);
        xa = xn; xn = xc;
        ya = yn; yn = yc;
        out_buf.data[idx] += yc;
    }
}
