#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(std430, binding = 0) readonly  buffer In   { vec4  data[]; } in_buf;
layout(std430, binding = 1)           buffer Out  { vec4  data[]; } out_buf;
layout(std430, binding = 2) readonly  buffer LR   { float data[]; } lutr;
layout(std430, binding = 3) readonly  buffer LG   { float data[]; } lutg;
layout(std430, binding = 4) readonly  buffer LB   { float data[]; } lutb;
layout(std430, binding = 5) readonly  buffer CM   { float data[]; } cmat;
layout(std430, binding = 6) readonly  buffer LM   { float data[]; } lmat;
layout(push_constant) uniform PC {
  int width; int height; int blue_mapping;
  float corr_x; float corr_y; float corr_z; float corr_w;
  float a_r0; float a_r1; float a_r2;
  float a_g0; float a_g1; float a_g2;
  float a_b0; float a_b1; float a_b2;
} pc;

const int VK_LUT_SIZE = 65536;

float vk_lerp_lookup(float lut[1], float x, float c0, float c1, float c2);
// Per-buffer lerp lookup — GLSL can't take buffer refs as args, so
// one specialised function per LUT.
#define LERP_LUT(NAME, BUF) \
float lerp_##NAME(float xx, float c0, float c1, float c2) { \
  if(c0 < 0.0) return xx; \
  if(xx < 1.0) { \
    float ft = clamp(xx * float(VK_LUT_SIZE - 1), 0.0, float(VK_LUT_SIZE - 1)); \
    int t = int(min(ft, float(VK_LUT_SIZE - 2))); \
    float f = ft - float(t); \
    return BUF.data[t] * (1.0 - f) + BUF.data[t + 1] * f; \
  } \
  return c1 * pow(xx * c0, c2); \
}
LERP_LUT(R, lutr)
LERP_LUT(G, lutg)
LERP_LUT(B, lutb)

vec4 xyz_to_lab(vec4 xyz) {
  // Mirrors dt_vulkan_common.h::vk_XYZ_to_Lab byte-for-byte.
  const vec3 d50i = vec3(1.0/0.9642, 1.0, 1.0/0.8249);
  const float eps = 216.0 / 24389.0;
  const float kap = 24389.0 / 27.0;
  vec3 t = xyz.xyz * d50i;
  vec3 f;
  f.x = (t.x > eps) ? pow(t.x, 1.0/3.0) : (kap * t.x + 16.0) / 116.0;
  f.y = (t.y > eps) ? pow(t.y, 1.0/3.0) : (kap * t.y + 16.0) / 116.0;
  f.z = (t.z > eps) ? pow(t.z, 1.0/3.0) : (kap * t.z + 16.0) / 116.0;
  return vec4(116.0 * f.y - 16.0,
              500.0 * (f.x - f.y),
              200.0 * (f.y - f.z),
              xyz.w);
}

void main() {
  int x = int(gl_GlobalInvocationID.x);
  int y = int(gl_GlobalInvocationID.y);
  if(x >= pc.width || y >= pc.height) return;
  int idx = y * pc.width + x;

  vec4 corr = vec4(pc.corr_x, pc.corr_y, pc.corr_z, pc.corr_w);
  vec4 pixel = corr * in_buf.data[idx];

  float cam[3];
  cam[0] = lerp_R(pixel.x, pc.a_r0, pc.a_r1, pc.a_r2);
  cam[1] = lerp_G(pixel.y, pc.a_g0, pc.a_g1, pc.a_g2);
  cam[2] = lerp_B(pixel.z, pc.a_b0, pc.a_b1, pc.a_b2);

  if(pc.blue_mapping != 0) {
    float YY = cam[0] + cam[1] + cam[2];
    if(YY > 0.0) {
      float zz = cam[2] / YY;
      if(zz > 0.5) {
        float t = (zz - 0.5) / (1.0 - 0.5) * min(1.0, YY / 0.8);
        cam[1] += t * 0.11;
        cam[2] -= t * 0.11;
      }
    }
  }

  float XYZ[3];
  for(int j = 0; j < 3; j++) {
    XYZ[j] = 0.0;
    for(int i = 0; i < 3; i++) XYZ[j] += cmat.data[3 * j + i] * cam[i];
  }
  vec4 xyz = vec4(XYZ[0], XYZ[1], XYZ[2], 0.0);
  vec4 lab = xyz_to_lab(xyz);
  pixel.xyz = lab.xyz;
  out_buf.data[idx] = pixel;
}
