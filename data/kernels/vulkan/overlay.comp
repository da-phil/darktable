// GLSL fallback for overlay.cl. See the .cl header for design.

#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer In   { vec4 data[]; } in_buf;
layout(std430, binding = 1) readonly buffer Argb { uint data[]; } argb_buf;
layout(std430, binding = 2)          buffer Out  { vec4 data[]; } out_buf;

layout(push_constant) uniform PC {
    int   width;
    int   height;
    float opacity;
    int   stride;
} pc;

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if(x >= pc.width || y >= pc.height) return;
    int idx = y * pc.width + x;

    vec4 i = in_buf.data[idx];

    int word_idx = (y * pc.stride + x * 4) / 4;
    uint v = argb_buf.data[word_idx];
    float b = float( v        & 0xffu) / 255.0;
    float g = float((v >>  8) & 0xffu) / 255.0;
    float r = float((v >> 16) & 0xffu) / 255.0;
    float a = float((v >> 24) & 0xffu) / 255.0 * pc.opacity;

    vec4 o;
    o.x = (1.0 - a) * i.x + pc.opacity * r;
    o.y = (1.0 - a) * i.y + pc.opacity * g;
    o.z = (1.0 - a) * i.z + pc.opacity * b;
    o.w = i.w;
    out_buf.data[idx] = o;
}
