// GLSL twin used by test_vulkan_capture.c: out = in + lut[i % 256].
// Exercises the 3-binding + batched-upload shape (the LUT pattern the
// module ports use for tone curves).
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, set = 0, binding = 0) buffer InBuf  { float v[]; } inb;
layout(std430, set = 0, binding = 1) buffer OutBuf { float v[]; } outb;
layout(std430, set = 0, binding = 2) buffer LutBuf { float v[]; } lut;
layout(push_constant) uniform PC { int width; int height; } pc;

void main()
{
  const uint x = gl_GlobalInvocationID.x;
  const uint y = gl_GlobalInvocationID.y;
  if(x >= uint(pc.width) || y >= uint(pc.height)) return;
  const uint i = y * uint(pc.width) + x;
  outb.v[i] = inb.v[i] + lut.v[i % 256u];
}
